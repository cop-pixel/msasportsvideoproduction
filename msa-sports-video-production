<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MSA Sports Video Production | Multi-Camera Live Cricket Broadcast &amp; Tournament Management</title>
<meta name="description" content="MSA Sports Video Production — multi-camera live streaming, highlights, replays and on-air brand promotions for cricket tournaments. Full tournament management from planning to closure. Crew experienced on ICC &amp; ACC events.">
<meta name="theme-color" content="#07080a">
<link rel="icon" href="BUSINESS LOGO.jpeg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=Inter:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  /* ============================================================
     MSA SPORTS VIDEO PRODUCTION — Token System
     Palette drawn from the brand crest: gunmetal black + broadcast gold.
     Display: Big Shoulders Display (structural, condensed, sports-signage).
     Body: Inter. Utility/data: Space Mono (scoreboard + timecode feel).
     Signature device: the broadcast "tally light" + on-air lower-third bars.
     ============================================================ */
  :root{
    --void:#07080a;
    --void-2:#0d0f13;
    --panel:#14171d;
    --panel-2:#1a1e25;
    --stroke:rgba(217,172,63,0.16);
    --stroke-soft:rgba(238,233,221,0.08);
    --gold-1:#f6dfa0;
    --gold-2:#d9ac3f;
    --gold-3:#9c7418;
    --paper:#efe9db;
    --paper-2:#e1dac8;
    --ink:#0d0e10;
    --mist:#aab1bb;
    --mist-2:#7b828d;
    --white:#f7f5ef;
    --live:#e0393f;
    --font-display:'Big Shoulders Display',sans-serif;
    --font-body:'Inter',sans-serif;
    --font-mono:'Space Mono',monospace;
    --wrap:1180px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--void);
    color:var(--white);
    font-family:var(--font-body);
    font-size:16px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  ul{margin:0;padding:0;list-style:none;}
  h1,h2,h3,h4{margin:0;font-family:var(--font-display);font-weight:800;letter-spacing:.01em;}
  p{margin:0;}
  .wrap{max-width:var(--wrap);margin:0 auto;padding:0 clamp(1.25rem,4vw,3rem);}
  section{position:relative;}

  ::selection{background:var(--gold-2);color:var(--ink);}

  /* focus visibility */
  a:focus-visible,button:focus-visible{outline:2px solid var(--gold-1);outline-offset:3px;}

  /* film-grain overlay — cinematic texture, restrained */
  .grain{
    position:fixed;inset:0;z-index:200;pointer-events:none;
    opacity:.05;mix-blend-mode:overlay;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }

  /* ---------- lower-third eyebrow (signature device) ---------- */
  .eyebrow{
    display:inline-flex;align-items:center;gap:.6em;
    padding:.5em 1.1em .5em 1.3em;
    background:linear-gradient(100deg,var(--gold-1),var(--gold-2) 55%,var(--gold-3));
    color:var(--ink);
    font-family:var(--font-mono);
    font-weight:700;
    letter-spacing:.16em;
    text-transform:uppercase;
    font-size:.72rem;
    clip-path:polygon(0 0,100% 0,93% 100%,0 100%);
  }
  .eyebrow::before{
    content:"";
    width:.5em;height:.5em;
    background:var(--ink);
    border-radius:50%;
    flex:none;
  }
  .eyebrow--light{
    background:linear-gradient(100deg,var(--ink),#22262e 60%,var(--ink));
    color:var(--gold-1);
  }
  .eyebrow--light::before{background:var(--gold-1);}

  .head-row{display:flex;flex-direction:column;gap:1.1rem;margin-bottom:2.8rem;}
  .head-row h2{font-size:clamp(2rem,4.4vw,3.1rem);line-height:1.05;text-transform:uppercase;color:var(--white);}
  .head-row .lede{max-width:620px;color:var(--mist);font-size:1.05rem;}

  /* ---------- tally light (signature) ---------- */
  .tally{
    display:inline-flex;align-items:center;gap:.55em;
    font-family:var(--font-mono);font-size:.72rem;font-weight:700;
    letter-spacing:.18em;color:var(--gold-1);text-transform:uppercase;
  }
  .tally__dot{
    width:8px;height:8px;border-radius:50%;
    background:var(--live);
    box-shadow:0 0 0 0 rgba(224,57,63,.65);
    animation:pulse 2.1s infinite;
  }
  @keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(224,57,63,.55);}
    70%{box-shadow:0 0 0 8px rgba(224,57,63,0);}
    100%{box-shadow:0 0 0 0 rgba(224,57,63,0);}
  }

  /* ============================================================
     NAV
     ============================================================ */
  .nav{
    position:fixed;top:0;left:0;right:0;z-index:100;
    padding:1.1rem 0;
    transition:padding .35s ease,background .35s ease,box-shadow .35s ease,border-color .35s ease;
    border-bottom:1px solid transparent;
  }
  .nav.is-scrolled{
    padding:.65rem 0;
    background:rgba(7,8,10,.86);
    backdrop-filter:blur(14px) saturate(1.1);
    border-color:var(--stroke-soft);
    box-shadow:0 10px 30px -20px rgba(0,0,0,.8);
  }
  .nav__inner{
    display:flex;align-items:center;justify-content:space-between;gap:1.5rem;
    max-width:var(--wrap);margin:0 auto;padding:0 clamp(1.25rem,4vw,3rem);
  }
  .nav__brand{display:flex;align-items:center;gap:.7rem;flex:none;}
  .nav__brand img{height:42px;width:auto;transition:height .35s ease;}
  .nav.is-scrolled .nav__brand img{height:34px;}
  .nav__brand-text{display:flex;flex-direction:column;line-height:1.05;}
  .nav__brand-text strong{font-family:var(--font-display);font-weight:800;font-size:1rem;letter-spacing:.02em;text-transform:uppercase;color:var(--white);}
  .nav__brand-text span{font-family:var(--font-mono);font-size:.6rem;letter-spacing:.16em;color:var(--gold-2);text-transform:uppercase;}

  .nav__links{display:flex;align-items:center;gap:1.7rem;}
  .nav__links a{
    font-size:.8rem;font-weight:600;letter-spacing:.04em;
    color:var(--mist);text-transform:uppercase;position:relative;
    padding:.3rem 0;transition:color .25s ease;white-space:nowrap;
  }
  .nav__links a::after{
    content:"";position:absolute;left:0;bottom:-2px;height:2px;width:0;
    background:var(--gold-2);transition:width .25s ease;
  }
  .nav__links a:hover{color:var(--white);}
  .nav__links a:hover::after{width:100%;}

  .nav__cta{display:flex;align-items:center;gap:1.4rem;flex:none;}
  .nav__phone{
    font-family:var(--font-mono);font-size:.82rem;font-weight:700;
    color:var(--white);border:1px solid var(--stroke);
    padding:.55rem 1.1rem;border-radius:2px;transition:border-color .25s ease,background .25s ease;
  }
  .nav__phone:hover{border-color:var(--gold-2);background:rgba(217,172,63,.08);}

  .nav__burger{display:none;background:none;border:0;cursor:pointer;padding:.4rem;flex:none;}
  .nav__burger span{display:block;width:24px;height:2px;background:var(--white);margin:5px 0;transition:transform .3s ease,opacity .3s ease;}

  .mobile-panel{
    position:fixed;inset:0;z-index:99;background:var(--void-2);
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rem;
    opacity:0;pointer-events:none;transition:opacity .35s ease;
  }
  .mobile-panel.is-open{opacity:1;pointer-events:auto;}
  .mobile-panel a{font-family:var(--font-display);font-size:2rem;text-transform:uppercase;color:var(--white);font-weight:700;}
  .mobile-panel .nav__phone{margin-top:1rem;}

  @media (max-width:900px){
    .nav__links{display:none;}
    .nav__cta .nav__phone{display:none;}
    .nav__burger{display:block;}
  }

  /* ============================================================
     HERO
     ============================================================ */
  .hero{
    min-height:100svh;
    display:flex;align-items:flex-end;
    padding:9rem 0 5rem;
    background:var(--void);
    isolation:isolate;
  }
  .hero__bg{
    position:absolute;inset:0;z-index:-2;
    background-image:
      linear-gradient(180deg,rgba(7,8,10,.55) 0%,rgba(7,8,10,.72) 45%,var(--void) 92%),
      linear-gradient(90deg,rgba(7,8,10,.75),rgba(7,8,10,.2) 55%),
      url('https://images.unsplash.com/photo-1750716413756-b66624b64ce4?q=80&w=2400&auto=format&fit=crop');
    background-size:cover;background-position:center 62%;
    opacity:.34;
  }
  @media (min-width:900px){
    .hero__bg{background-attachment:fixed;}
  }
  .hero__vignette{position:absolute;inset:0;z-index:-1;box-shadow:inset 0 0 220px 40px rgba(0,0,0,.85);}

  .hero__inner{max-width:var(--wrap);margin:0 auto;padding:0 clamp(1.25rem,4vw,3rem);width:100%;}
  .hero__crest{
    display:inline-flex;align-items:center;gap:.7rem;
    margin-bottom:1.6rem;opacity:0;animation:riseIn .9s .15s ease forwards;
  }
  .hero__crest img{height:54px;width:auto;}
  .hero__crest-text{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.22em;color:var(--gold-1);text-transform:uppercase;}

  .hero h1{
    font-size:clamp(2.7rem,8vw,6.4rem);
    line-height:.94;text-transform:uppercase;
    opacity:0;animation:riseIn 1s .3s ease forwards;
  }
  .hero h1 .line{display:block;}
  .hero h1 .accent{
    background:linear-gradient(100deg,var(--gold-1) 10%,var(--gold-2) 55%,var(--gold-3) 95%);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }

  .hero__tagline{
    margin-top:1.5rem;font-family:var(--font-display);font-weight:700;
    font-size:clamp(1.15rem,2.2vw,1.6rem);color:var(--paper);
    letter-spacing:.01em;text-transform:uppercase;
    border-left:3px solid var(--gold-2);padding-left:1rem;
    max-width:640px;opacity:0;animation:riseIn 1s .5s ease forwards;
  }
  .hero__sub{
    margin-top:1.3rem;max-width:560px;color:var(--mist);font-size:1.02rem;
    opacity:0;animation:riseIn 1s .65s ease forwards;
  }

  .hero__actions{
    display:flex;flex-wrap:wrap;gap:1rem;margin-top:2.4rem;
    opacity:0;animation:riseIn 1s .8s ease forwards;
  }
  .btn{
    display:inline-flex;align-items:center;gap:.6rem;
    padding:.95rem 1.7rem;font-family:var(--font-mono);
    font-size:.8rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
    border-radius:2px;transition:transform .25s ease,box-shadow .25s ease,background .25s ease,color .25s ease;
    cursor:pointer;border:1px solid transparent;
  }
  .btn--gold{
    background:linear-gradient(100deg,var(--gold-1),var(--gold-2) 70%);color:var(--ink);
  }
  .btn--gold:hover{transform:translateY(-2px);box-shadow:0 14px 26px -12px rgba(217,172,63,.55);}
  .btn--ghost{border-color:var(--stroke);color:var(--white);}
  .btn--ghost:hover{border-color:var(--gold-2);background:rgba(217,172,63,.08);transform:translateY(-2px);}

  .hero__scroll{
    position:absolute;left:50%;bottom:2.1rem;transform:translateX(-50%);
    display:flex;flex-direction:column;align-items:center;gap:.5rem;
    opacity:.7;
  }
  .hero__scroll span{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.2em;color:var(--mist);text-transform:uppercase;}
  .hero__scroll i{width:1px;height:34px;background:linear-gradient(var(--gold-2),transparent);position:relative;overflow:hidden;}
  .hero__scroll i::after{content:"";position:absolute;top:-34px;left:0;width:100%;height:100%;background:var(--gold-1);animation:scrollLine 2.2s infinite ease-in-out;}
  @keyframes scrollLine{0%{top:-34px;}100%{top:34px;}}

  @keyframes riseIn{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}

  /* ============================================================
     REEL
     ============================================================ */
  .reel{background:var(--void-2);padding:6.5rem 0 7rem;border-top:1px solid var(--stroke-soft);border-bottom:1px solid var(--stroke-soft);}
  .reel__head{text-align:center;max-width:640px;margin:0 auto 3rem;display:flex;flex-direction:column;align-items:center;gap:1.1rem;}
  .reel__head h2{font-size:clamp(2rem,4.4vw,3rem);text-transform:uppercase;}
  .reel__head p{color:var(--mist);}

  .reel__monitor{
    max-width:860px;margin:0 auto;
    padding:.9rem;
    background:linear-gradient(160deg,#22262e,#111318 60%);
    border-radius:14px;
    border:1px solid rgba(217,172,63,.22);
    box-shadow:0 40px 80px -30px rgba(0,0,0,.75),inset 0 1px 0 rgba(255,255,255,.04);
  }
  .reel__bar{
    display:flex;align-items:center;justify-content:space-between;
    padding:.3rem .5rem .8rem;
  }
  .reel__bar-left{display:flex;align-items:center;gap:.6rem;}
  .reel__bar-left .dot{width:8px;height:8px;border-radius:50%;background:var(--live);box-shadow:0 0 0 0 rgba(224,57,63,.6);animation:pulse 2.1s infinite;}
  .reel__bar-left span{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.14em;color:var(--gold-1);text-transform:uppercase;}
  .reel__bar-right{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.1em;color:var(--mist-2);}

  .reel__frame{
    position:relative;width:100%;aspect-ratio:16/9;
    border-radius:8px;overflow:hidden;background:#000;
  }
  .reel__frame video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000;}

  .reel__foot{display:flex;justify-content:space-between;padding:.8rem .5rem .2rem;font-family:var(--font-mono);font-size:.62rem;letter-spacing:.14em;color:var(--mist-2);text-transform:uppercase;}

  /* ============================================================
     SERVICES
     ============================================================ */
  .services{background:var(--void);padding:7.5rem 0;}
  .services__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.6rem;margin-bottom:4rem;}
  @media (max-width:900px){.services__grid{grid-template-columns:1fr;}}

  .s-card{
    background:linear-gradient(165deg,var(--panel),var(--panel-2));
    border:1px solid var(--stroke-soft);
    border-radius:6px;
    padding:2.4rem 2rem 2.2rem;
    transition:transform .35s ease,border-color .35s ease,box-shadow .35s ease;
  }
  .s-card:hover{transform:translateY(-6px);border-color:var(--stroke);box-shadow:0 24px 46px -28px rgba(0,0,0,.7);}

  .s-icon{margin-bottom:1.6rem;height:40px;display:flex;align-items:center;}
  /* multicam grid icon */
  .icon-multicam{display:grid;grid-template-columns:repeat(2,16px);grid-template-rows:repeat(2,16px);gap:4px;}
  .icon-multicam span{border:1.5px solid var(--gold-2);border-radius:2px;position:relative;}
  .icon-multicam span::after{content:"";position:absolute;top:2px;right:2px;width:3px;height:3px;border-radius:50%;background:var(--gold-1);}
  /* replay icon */
  .icon-replay{width:38px;height:38px;}
  .icon-replay circle{fill:none;stroke:var(--gold-2);stroke-width:2;stroke-dasharray:88;stroke-dashoffset:18;}
  .icon-replay polygon{fill:var(--gold-1);}
  /* promo icon: mini lower-third */
  .icon-promo{width:44px;height:26px;background:linear-gradient(100deg,var(--gold-1),var(--gold-3));clip-path:polygon(0 0,100% 0,86% 100%,0 100%);position:relative;}
  .icon-promo::after{content:"";position:absolute;left:6px;top:8px;width:20px;height:3px;background:var(--ink);border-radius:1px;}
  .icon-promo::before{content:"";position:absolute;left:6px;bottom:7px;width:12px;height:3px;background:var(--ink);border-radius:1px;}

  .s-card h3{font-size:1.35rem;text-transform:uppercase;color:var(--white);margin-bottom:.8rem;letter-spacing:.01em;}
  .s-card p{color:var(--mist);font-size:.95rem;}

  /* tournament management block */
  .tourn{
    display:grid;grid-template-columns:.85fr 1.15fr;gap:3.5rem;align-items:center;
    background:linear-gradient(120deg,var(--panel-2),var(--panel));
    border:1px solid var(--stroke);border-radius:8px;
    padding:3.2rem clamp(1.6rem,4vw,3.4rem);margin-bottom:4rem;
    position:relative;overflow:hidden;
  }
  .tourn::before{
    content:"";position:absolute;inset:0;
    background:radial-gradient(600px 260px at 100% 0%,rgba(217,172,63,.14),transparent 70%);
    pointer-events:none;
  }
  @media (max-width:900px){.tourn{grid-template-columns:1fr;gap:2.2rem;}}

  .tourn__copy h3{font-size:clamp(1.7rem,3vw,2.3rem);text-transform:uppercase;line-height:1.08;color:var(--white);margin:1rem 0 1.1rem;}
  .tourn__copy p{color:var(--mist);font-size:1rem;}

  .process{display:flex;flex-direction:column;gap:0;position:relative;}
  .process::before{content:"";position:absolute;left:16px;top:8px;bottom:8px;width:1px;background:linear-gradient(var(--gold-2),transparent 96%);}
  .p-step{display:flex;gap:1.1rem;padding:.85rem 0;position:relative;}
  .p-step__num{
    flex:none;width:33px;height:33px;border-radius:50%;
    background:var(--void);border:1px solid var(--gold-2);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--font-mono);font-size:.72rem;color:var(--gold-1);font-weight:700;
    position:relative;z-index:1;
  }
  .p-step__body strong{display:block;font-family:var(--font-display);font-size:1.05rem;text-transform:uppercase;color:var(--white);letter-spacing:.02em;}
  .p-step__body span{font-size:.86rem;color:var(--mist-2);}

  /* credential strip */
  .credential{
    display:flex;align-items:center;gap:2.2rem;flex-wrap:wrap;
    background:var(--void-2);border:1px solid var(--stroke-soft);border-radius:8px;
    padding:2rem clamp(1.4rem,4vw,2.6rem);
  }
  .credential__badges{display:flex;gap:1rem;flex:none;}
  .badge-logo{
    width:78px;height:78px;flex:none;
    background:linear-gradient(155deg,var(--paper),var(--paper-2));
    border-radius:10px;padding:.75rem;
    display:flex;align-items:center;justify-content:center;
    box-shadow:inset 0 2px 3px rgba(255,255,255,.7),inset 0 -3px 6px rgba(0,0,0,.18),0 10px 18px -12px rgba(0,0,0,.6);
  }
  .badge-logo img{max-width:100%;max-height:100%;object-fit:contain;}
  .credential__text{flex:1;min-width:240px;}
  .credential__text strong{display:block;font-family:var(--font-display);font-size:1.2rem;text-transform:uppercase;color:var(--white);margin-bottom:.35rem;}
  .credential__text p{color:var(--mist);font-size:.93rem;max-width:640px;}

  /* ============================================================
     REVIEWS
     ============================================================ */
  .reviews{background:var(--void-2);padding:7.5rem 0;border-top:1px solid var(--stroke-soft);border-bottom:1px solid var(--stroke-soft);}
  .reviews__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.4rem;}
  @media (max-width:1080px){.reviews__grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:600px){.reviews__grid{grid-template-columns:1fr;}}

  .r-card{
    background:var(--panel);border:1px solid var(--stroke-soft);border-radius:6px;
    padding:1.9rem 1.6rem;display:flex;flex-direction:column;gap:1rem;
    transition:border-color .3s ease,transform .3s ease;
  }
  .r-card:hover{border-color:var(--stroke);transform:translateY(-4px);}
  .stars{display:flex;gap:.2rem;}
  .stars svg{width:15px;height:15px;}
  .stars svg.fill{fill:var(--gold-2);}
  .stars svg.empty{fill:none;stroke:var(--mist-2);stroke-width:1.5;}
  .r-card p{color:var(--paper);font-size:.94rem;font-style:italic;line-height:1.55;}
  .r-card footer{display:flex;flex-direction:column;gap:.1rem;margin-top:auto;padding-top:.4rem;border-top:1px solid var(--stroke-soft);}
  .r-card footer strong{font-family:var(--font-display);font-size:.95rem;text-transform:uppercase;color:var(--white);letter-spacing:.02em;}
  .r-card footer span{font-family:var(--font-mono);font-size:.68rem;color:var(--mist-2);letter-spacing:.04em;text-transform:uppercase;}

  /* ============================================================
     CLIENTS
     ============================================================ */
  .clients{background:var(--void);padding:7.5rem 0;}
  .clients__grid{
    display:grid;grid-template-columns:repeat(4,1fr);gap:1.6rem;
  }
  @media (max-width:900px){.clients__grid{grid-template-columns:repeat(3,1fr);}}
  @media (max-width:560px){.clients__grid{grid-template-columns:repeat(2,1fr);}}

  .client-item{display:flex;flex-direction:column;align-items:center;gap:.7rem;}
  .client-plate{
    width:100%;aspect-ratio:1/1;
    background:linear-gradient(155deg,var(--paper),var(--paper-2));
    border-radius:14px;
    box-shadow:
      inset 0 2px 3px rgba(255,255,255,.75),
      inset 0 -4px 8px rgba(0,0,0,.2),
      0 12px 22px -14px rgba(0,0,0,.65);
    display:flex;align-items:center;justify-content:center;
    padding:1.3rem;
    transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s ease;
  }
  .client-plate img{
    max-width:100%;max-height:100%;object-fit:contain;
    filter:grayscale(1) contrast(1.05);opacity:.8;
    transition:filter .4s ease,opacity .4s ease,transform .4s ease;
  }
  .client-item:hover .client-plate{
    transform:translateY(-7px) rotate(-.6deg);
